# 将需要的配置复制到项目根目录 .env，不要把真实 API Key 提交到 Git。

# 第一阶段默认保持关闭；写完 Agent 后端基础类并完成测试后再改为 true。
AGENT_ENABLED=false

# none 表示不创建 ChatModel；正式联调时改成 openai。
AI_MODEL_PROVIDER=none

# OpenAI 官方地址或兼容 OpenAI 协议的服务地址。
AI_BASE_URL=https://api.openai.com

# 仅在本地 .env 或部署密钥系统中填写真实值。
AI_API_KEY=replace-with-your-api-key

# 按所选供应商填写支持 Tool Calling 的模型名。
AI_CHAT_MODEL=gpt-5-mini

AGENT_MAX_HISTORY_TURNS=10
AGENT_RATE_LIMIT_PER_MINUTE=10
AGENT_MAX_TOOL_CALLS=8
AGENT_RUN_TIMEOUT_SECONDS=45
# 必须大于上面的 Agent 总超时，为数据库失败收口和最后一个 SSE 事件预留时间。
AGENT_SSE_REQUEST_TIMEOUT=60s
AGENT_ACTION_TTL_MINUTES=10
AGENT_MAX_INPUT_CHARS=1000
AGENT_MAX_OUTPUT_TOKENS=1200
