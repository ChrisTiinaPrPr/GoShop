# GoShop 本地环境变量示例
#
# 复制为 .env 后再填写本机值：Copy-Item .env.example .env
# 所有密码、Token、私钥和账号专属标识都故意留空，禁止把填写后的 .env 提交到 Git。

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=goshop
MYSQL_USER=root
MYSQL_PASSWORD=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=goshop
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=/goshop

# JWT：至少 32 字节。请使用密码管理器或安全随机生成器创建，不能复用示例值。
JWT_SECRET=
JWT_ACCESS_TOKEN_MINUTES=120

# 阿里云 OSS
ALIYUN_OSS_ENDPOINT=
ALIYUN_OSS_BUCKET_NAME=
ALIYUN_OSS_CHAT_BUCKET_NAME=
ALIYUN_OSS_AI_BUCKET_NAME=
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=

# 支付宝沙箱
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_NOTIFY_URL=http://localhost:8080/api/v1/payments/alipay/callback
ALIPAY_RETURN_URL=http://localhost:8080/api/v1/payments/alipay/return
PAYMENT_FRONTEND_RETURN_URL=http://localhost:5173/orders

# 买家购物 Agent：默认关闭；配置真实模型服务后再启用。
AGENT_ENABLED=false
AI_MODEL_PROVIDER=none
AI_BASE_URL=https://api.openai.com
AI_API_KEY=
AI_CHAT_MODEL=gpt-5-mini
AGENT_MAX_HISTORY_TURNS=10
AGENT_RATE_LIMIT_PER_MINUTE=10
AGENT_MAX_TOOL_CALLS=8
AGENT_RUN_TIMEOUT_SECONDS=45
AGENT_SSE_REQUEST_TIMEOUT=60s
AGENT_ACTION_TTL_MINUTES=10
AGENT_MAX_INPUT_CHARS=1000
AGENT_MAX_OUTPUT_TOKENS=1200

# 商家智能导购 RAG：默认关闭；启用时同时配置 Embedding 与 Qdrant。
MERCHANT_AI_RAG_ENABLED=false
MERCHANT_AI_VECTOR_STORE_TYPE=none
AI_EMBEDDING_PROVIDER=none
AI_EMBEDDING_BASE_URL=
AI_EMBEDDING_MODEL=
RAG_EMBEDDING_API_KEY=
QDRANT_HOST=localhost
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=
QDRANT_COLLECTION=goshop_merchant_knowledge

# 聊天与缓存
CHAT_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
CHAT_IMAGE_SIGNED_URL_MINUTES=10
CHAT_IMAGE_MAX_SIZE_MB=5
CHAT_MESSAGE_RATE_PER_MINUTE=30
PRODUCT_CACHE_ENABLED=true
